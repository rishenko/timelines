{
  "name": "timelines",
  "private": true,
  "version": "0.0.0",
  "homepage": "https://rishenko.github.io/timelines",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "data": "node scripts/data.ts",
    "data:ancient": "node scripts/data.ts build ancient",
    "data:classical": "node scripts/data.ts build classical",
    "data:REDACTED": "node scripts/upgrade-dataset.ts ../REDACTED/src/data/timeline.json src/timelines/REDACTED.json",
    "importance:ancient": "node scripts/data.ts importance ancient",
    "importance:classical": "node scripts/data.ts importance classical",
    "format:src": "node scripts/data.ts format all",
    "row-order": "node scripts/data.ts row-order ancient --best",
    "audit:batches": "node scripts/audit-batches.ts",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "shot": "node scripts/screenshot.ts",
    "check:live": "node scripts/check-live.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "gh-pages": "^6.3.0",
    "jsdom": "^31.0.1",
    "oxlint": "^1.90.0",
    "playwright-core": "^1.65.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
