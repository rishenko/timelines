{
  "name": "timelines",
  "private": true,
  "version": "0.0.0",
  "homepage": "https://rishenko.github.io/timelines",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "dom-snapshot": "vitest run src/test/dom-snapshot.test.tsx",
    "data": "node scripts/data.ts",
    "data:build": "node scripts/data.ts build all",
    "data:check": "node scripts/data.ts run-all ancient-classical --check",
    "importance": "node scripts/data.ts importance all",
    "format:src": "node scripts/data.ts format all",
    "map:fetch": "node scripts/map/fetch-places.ts",
    "map:build": "node scripts/map/build-map.ts",
    "row-order": "node scripts/data.ts row-order ancient-classical --best",
    "audit:batches": "node scripts/audit-batches.ts",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "shot": "node scripts/screenshot.ts",
    "check:live": "node scripts/check-live.ts",
    "contrast": "node scripts/contrast.ts",
    "contrast:ui": "node scripts/contrast-ui.ts",
    "reflow": "node scripts/reflow.ts",
    "targets": "node scripts/targets.ts",
    "a11y:report": "node scripts/a11y-report.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.1",
    "gh-pages": "^6.3.0",
    "jsdom": "^31.0.1",
    "oxlint": "^1.90.0",
    "playwright-core": "^1.65.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
