{
  "name": "timelines",
  "private": true,
  "version": "0.0.0",
  "homepage": "https://rishenko.github.io/timelines",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:ancient": "node scripts/build-dataset.ts data-src/ancient-near-east.json src/timelines/ancient-near-east.json",
    "importance:ancient": "node scripts/set-importance.ts data-src/ancient-near-east.json --plan data-src/ancient-importance.json && npm run data:ancient && node scripts/list-importance.ts src/timelines/ancient-near-east.json docs/ancient-key-events.md",
    "format:src": "node scripts/format-source.ts data-src/ancient-near-east.json",
    "row-order": "node scripts/row-order.ts src/timelines/ancient-near-east.json --best",
    "data:REDACTED": "node scripts/upgrade-dataset.ts ../REDACTED/src/data/timeline.json src/timelines/REDACTED.json",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "shot": "node scripts/screenshot.ts",
    "check:live": "node scripts/check-live.ts",
    "data:classical": "node scripts/build-dataset.ts data-src/classical.json src/timelines/classical.json",
    "importance:classical": "node scripts/set-importance.ts data-src/classical.json --plan data-src/classical-importance.json && npm run data:classical && node scripts/list-importance.ts src/timelines/classical.json docs/classical-key-events.md"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "gh-pages": "^6.3.0",
    "jsdom": "^31.0.1",
    "oxlint": "^1.90.0",
    "playwright-core": "^1.65.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
