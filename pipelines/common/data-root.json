    "v2": "v2",
    "periodo": "periodo",
    "ics": "ics",
    "europepmc": "europepmc",
    "smithsonian": "smithsonian",
    "traditions": "traditions-sources",
    "cliopatria": "cliopatria",
    "archigos": "archigos",
    "stages": "stages",
    "regressionInputs": "regression-inputs",
    "drop": "drop",
    "local": "local"
  },
  "overrideEnv": {
    "stages": "TIMELINES_STAGES",
    "regressionInputs": "REGRESSION_INPUTS"
  }
}
