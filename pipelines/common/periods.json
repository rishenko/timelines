  {"uuid": "carolingian-renaissance", "title": "Carolingian Renaissance", "timeline": "medieval", "descr": "Under Charlemagne and Louis the Pious, court scholars such as Alcuin of York revive learning on Roman and Greek models: literature, writing, the arts, architecture, music and law grow, and Carolingian schools copy and edit the classics.",
   "basis": [["Carolingian Renaissance", "Charlemagne and Louis the Pious"], ["Carolingian Renaissance", "notably Alcuin of York"], ["Carolingian Renaissance", "an increase of literature, writing, visual arts"], ["Carolingian Renaissance", "producing editions and copies of the classics"]], "tracks": ["carolingian-empire"],
   "start": [{"year": 750, "article": "Carolingian Renaissance", "find": "beginning in the 8th century", "margin": 50, "note": "The 8th century."}],
   "end": [{"year": 900, "article": "Carolingian Renaissance", "find": "beginning in the 8th century", "margin": 50, "note": "\"Continuing throughout the 9th century\"."}]},
  {"uuid": "macedonian-renaissance", "title": "Macedonian Renaissance", "timeline": "medieval", "descr": "Byzantine culture blossoms under the Macedonian dynasty after the upheavals of the 7th and 8th centuries. Scholars set out to organise and codify knowledge, as in the works of the scholar emperor Constantine VII.",
