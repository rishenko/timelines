  {"uuid": "golden-age-of-athens", "title": "Golden Age of Athens", "timeline": "ancient-classical", "descr": "After the Persian invasion is defeated, Athens leads the Delian League and turns it into an empire whose treasury pays for the Acropolis. Under Pericles the city is home to the playwrights Aeschylus, Sophocles and Euripides, the historians Herodotus and Thucydides, and the philosophers Socrates and Plato.",
   "basis": [["Athens in the 5th century BC", "Delian League, confronted the Persians"], ["Athens in the 5th century BC", "funded the building of the Athenian Acropolis"], ["Athens in the 5th century BC", "statesman and orator Pericles"], ["Athens in the 5th century BC", "Aeschylus, Sophocles and Euripides"]], "tracks": ["greece"],
   "start": [{"year": "478 BCE", "article": "Athens in the 5th century BC", "find": "478 BC"}],
   "end": [{"year": "404 BCE", "article": "Athens in the 5th century BC", "short": true},
