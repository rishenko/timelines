  "chronologies": {
    "middle": {
      "name": "Middle Chronology",
      "group": "Mesopotamia & Anatolia",
      "default": true,
      "description": "Fall of Babylon in 1595 BCE; Hammurabi reigns 1792–1750 BCE. Wikipedia calls it the most commonly seen solution, 'but there is far from a consensus'.",
      "source": {
        "sourceKey": "wp-chron-ane",
        "sourceLocation": "Middle Bronze Age; table 'Variant Middle Bronze Age chronologies'"
      }
    },
    "high": {
      "name": "High (Long) Chronology",
      "group": "Mesopotamia & Anatolia",
      "description": "Fall of Babylon in 1651 BCE: 56 years earlier than the Middle Chronology. Applied here to dates before 1400 BCE (see docs/ancient-sources.md).",
      "source": {
        "sourceKey": "wp-chron-ane",
        "sourceLocation": "table 'Variant Middle Bronze Age chronologies'"
      },
      "derive": {
        "from": "middle",
        "offset": -56,
        "until": -1399
      }
    },
    "low": {
      "name": "Low (Short) Chronology",
      "group": "Mesopotamia & Anatolia",
      "description": "Fall of Babylon in 1531 BCE: 64 years later than the Middle Chronology. Where a source gives its own short-chronology date, that date is used instead of the shift.",
      "source": {
        "sourceKey": "wp-chron-ane",
        "sourceLocation": "table 'Variant Middle Bronze Age chronologies'"
      },
      "derive": {
        "from": "middle",
        "offset": 64,
        "until": -1399
      }
    },
    "aegean-high": {
      "name": "High (radiocarbon) Aegean chronology",
      "group": "Aegean",
      "default": true,
      "description": "Absolute dates for the Minoan and Helladic phases based on radiocarbon (Manning 2012), with the Thera eruption in the late 17th or 16th century BCE.",
      "source": {
        "sourceKey": "wp-minoan-chron",
        "sourceLocation": "table, note 1 ('based on Manning (2012)')"
      }
    },
    "aegean-low": {
      "name": "Low (conventional) Aegean chronology",
      "group": "Aegean",
      "description": "Dates from archaeological synchronisms with Egypt, roughly a century later for the eruption and early Late Bronze Age phases.",
      "source": {
        "sourceKey": "wp-minoan-chron",
        "sourceLocation": "prose on 'low chronological assessments'"
      }
    }
  }
